{
  "queries": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"default\"}[5m])) by (pod)",
      "refId": "A",
      "maxDataPoints": 100
    }
  ],
  "from": "now-15m",
  "to": "now"
}
